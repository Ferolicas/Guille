# Base de datos PostgreSQL del VPS
DATABASE_URL=postgresql://guille_user:password@localhost:5432/guille_db

# Aplicación
NODE_ENV=production
PORT=4011
APP_URL=https://guilloguambi.com
AUTH_SECRET=
PANEL_RECOVERY_EMAIL=guilloguambi@gmail.com
UPLOAD_ROOT=/var/www/guille-data/uploads

# Contacto público (solo dígitos y prefijo internacional para WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=

# Correo transaccional. SMTP2GO es el proveedor principal; Resend queda como respaldo.
SMTP2GO_API_KEY=
SMTP2GO_API_URL=https://eu-api.smtp2go.com/v3/email/send
RESEND_API_KEY=
CONTACT_TO_EMAIL=guilloguambi@gmail.com
CONTACT_FROM_EMAIL=contacto@guilloguambi.com

# Integraciones estándar reservadas
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
